APP_NAME="School Lesson Plan Management System"
APP_ENV=production
APP_KEY=base64:rySqnXYWLZrpqY9OBlrJRqxauA4ZP+v/U/L+pEMc8d4=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://lessonplan.firoz-ahmed.com
FRONTEND_URL=https://lessonplan.firoz-ahmed.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bn_BD

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# 🗄️ Database Configuration
# Option 1: SQLite Zero-Config (100% Automatic - No cPanel MySQL database setup needed!)
DB_CONNECTION=sqlite

# Option 2: MySQL (Uncomment and set if you prefer cPanel MySQL database)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_cpanel_dbname
# DB_USERNAME=your_cpanel_dbuser
# DB_PASSWORD=your_cpanel_dbpassword


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.firoz-ahmed.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=lessonplan.firoz-ahmed.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@bsisc.edu.bd"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"